---
import Section from '../UI/Section.astro';
import { EDUCATION } from '../../data/education';
---
<Section id="education" title="Education"><div class="education-list">{EDUCATION.map(item => <article class="education-row"><div><h3>{item.title}</h3><p>{item.description}</p></div><span>{item.date}</span></article>)}</div></Section>

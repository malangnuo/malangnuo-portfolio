---
interface Props { id: string; title?: string; className?: string; titleClassName?: string; }
const { id, title, className } = Astro.props;
const labels: Record<string, string> = { about: '01 / ABOUT', projects: '02 / EXPERIENCE', education: '03 / EDUCATION', skills: '04 / SKILLS', contact: '05 / CONTACT' };
---
<section id={id} class:list={['portfolio-section', className]}>
  <div class="section-label">{labels[id]}</div>
  <div class="section-body">{title && <h2 class="section-title">{title}</h2>}<slot /></div>
</section>

---
interface Props { company: string; title: string; description: string; date: string; job: string; tags: Array<{name: string}>; link?: string; }
const { company, title, description, date, job, tags, link } = Astro.props;
---
<article class="project-card"><div class="project-meta"><span>{job}</span><span>{date}</span></div><h4>{title}</h4><p>{description}</p><footer class="project-bottom"><div class="project-tags">{tags.map(tag => <span>{tag.name}</span>)}</div>{link && <a href={link} target="_blank" rel="noopener noreferrer">관련 기록 ↗</a>}</footer>{company === 'Gurufin' && <div class="related-posts"><a href="https://malangnuo.com/posts/eks-pod-requests-rightsizing/" target="_blank" rel="noopener noreferrer">EKS 리소스 최적화 ↗</a><a href="https://malangnuo.com/posts/gurufin-observability-integration/" target="_blank" rel="noopener noreferrer">모니터링 통합 ↗</a></div>}</article>

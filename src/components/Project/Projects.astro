---
import CardProject from './CardProject.astro';
import Section from '../UI/Section.astro';
import { PROJECTS, companyPeriods } from '../../data/projects';
const companies = [...new Set(PROJECTS.map(project => project.company))];
---
<Section id="projects" title="Work Experiences">{companies.map(company => <div class="company-group"><div class="company-heading"><h3>{company}</h3><span>{companyPeriods[company]}</span></div><div class="project-list">{PROJECTS.filter(project => project.company === company).map(project => <CardProject {...project} />)}</div></div>)}</Section>

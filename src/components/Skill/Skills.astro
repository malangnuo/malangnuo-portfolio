---
import Section from '../UI/Section.astro';
import { SKILLS } from '../../data/skills';
const groups = [
 { title: 'Cloud & Infrastructure', tags: ['AWS', 'NHN Cloud', 'Proxmox', 'Terraform'] },
 { title: 'Platform & Delivery', tags: ['Kubernetes', 'EKS', 'Docker', 'Argo CD', 'Jenkins', 'GitLab'] },
 { title: 'Observability & Automation', tags: ['Grafana', 'Alloy', 'Loki', 'Tempo', 'Prometheus', 'Python'] }
];
---
<Section id="skills" title="Skills & Language">{groups.map(group => <div class="skill-group"><h3>{group.title}</h3><div class="skill-tags">{group.tags.map(tag => <span>{tag}</span>)}</div></div>)}<div class="skill-group"><h3>Language</h3><p>{SKILLS.find(skill => skill.title === 'English')?.description}</p></div></Section>

---
import { PERSONAL_INFO } from '../../data/personal';
import Section from '../UI/Section.astro';
---
<Section id="about" title="About Me"><div class="about-grid"><div class="about-copy"><h3>{PERSONAL_INFO.title}</h3><p>안녕하세요! <strong>{PERSONAL_INFO.name}</strong>입니다. {PERSONAL_INFO.description}</p><p>{PERSONAL_INFO.journey}</p><div class="value-tags">{PERSONAL_INFO.skills.map(skill => <span>{skill}</span>)}</div></div><img class="profile-photo" src="/images/profile.jpg" width="1200" height="899" alt={`${PERSONAL_INFO.name} Portrait`} loading="lazy" /></div></Section>
